# --- Aparat Intelligence configuration -------------------------------
# Copy to ~/.config/aparat-intelligence/config.json (mode 0600).
#
# No API keys needed. All AI reasoning is done by the active Hermes model.
# This file only tunes the local media pipeline.

{
  "transcription": {
    "language": "auto",
    "chunk_seconds": 600
  },
  "frames": {
    "interval_seconds": 30,
    "scene_threshold": 0.3,
    "max_frames": 50
  },
  "download": {
    "max_bytes": 536870912
  }
}
